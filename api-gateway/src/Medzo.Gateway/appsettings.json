{
  "Logging": {
    "LogLevel": { "Default": "Information", "Microsoft.AspNetCore": "Warning" }
  },
  "AllowedHosts": "*",
  "Cors": { "AllowedOrigins": [] },
  "ReverseProxy": {
    "Routes": {
      "auth": { "ClusterId": "auth", "Match": { "Path": "/api/auth/{**remainder}" } },
      "users": { "ClusterId": "auth", "Match": { "Path": "/api/users/{**remainder}" } },
      "dashboard": { "ClusterId": "auth", "Match": { "Path": "/api/dashboard/{**remainder}" } },
      "reviews": { "ClusterId": "auth", "Match": { "Path": "/api/reviews" } },
      "contact": { "ClusterId": "auth", "Match": { "Path": "/api/contact" } }
    },
    "Clusters": {
      "auth": {
        "HttpRequest": { "ActivityTimeout": "00:00:30" },
        "Destinations": { "primary": { "Address": "http://localhost:5080/" } }
      }
    }
  }
}
